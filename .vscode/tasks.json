{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Mock ERP API",
      "type": "shell",
      "command": ".venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080",
      "options": {
        "cwd": "${workspaceFolder}/mock_api"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "panel": "new"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
